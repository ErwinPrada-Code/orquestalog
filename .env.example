# Copiar este archivo a .env y ajustar los valores
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/orquestalog
# Generar uno propio con: openssl rand -hex 32
SECRET_KEY=cambia_esto_por_una_clave_larga_y_aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Poner en true para ver todo el SQL en consola (solo depuración)
DB_ECHO=false